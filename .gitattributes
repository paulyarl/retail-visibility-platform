* text=auto
# Force LF for source and docs
*.js  text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh  text eol=lf
# pnpm hashes patch file bytes and records the LF hash in pnpm-lock.yaml.
# With autocrlf=true a CRLF checkout makes the hash mismatch and installs fail
# with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH on "patchedDependencies".
*.patch text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf