# API env example
API_PORT=4000

# Database — Local dev (SQLite)
# DATABASE_URL="file:./prisma/dev.db"

# Database — Supabase pooler (PgBouncer/Supavisor)
# Port 6543 = pooler (for app queries), Port 5432 = direct (for migrations)
# pgbouncer=true is REQUIRED for Prisma to work through the Supabase pooler
# connection_limit=5 keeps Prisma's pool small to avoid exhausting Supabase connections
# DATABASE_URL="postgresql://postgres.[project]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.[project]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Email Configuration
EMAIL_PROVIDER=mailtrap  # Options: sendgrid, ses, mailtrap, console
EMAIL_FALLBACK_PROVIDERS=sendgrid,ses,console  # Comma-separated fallback order
EMAIL_FROM=noreply@visibleshelf.com
EMAIL_REPLY_TO=claims@visibleshelf.com
EMAIL_FROM_NAME=VisibleShelf

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@visibleshelf.com
SENDGRID_FROM_NAME=VisibleShelf

# AWS SES Configuration  
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_FROM_EMAIL=noreply@visibleshelf.com
AWS_SES_FROM_NAME=VisibleShelf

# Mailtrap Configuration (for testing)
MAILTRAP_TOKEN=your_mailtrap_token
MAILTRAP_ACCOUNT_ID=your_mailtrap_account_id
MAILTRAP_INBOX_ID=your_mailtrap_inbox_id
MAILTRAP_FROM_EMAIL=noreply@visibleshelf.com
MAILTRAP_FROM_NAME=VisibleShelf

# Square POS Integration
SQUARE_APPLICATION_ID=your_square_application_id
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_ENVIRONMENT=sandbox  # or 'production'
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key
SQUARE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/square/callback

# Barcode Enrichment — Commercial API Providers
BARCODELOOKUP_API_KEY=your_barcodelookup_api_key
GOUPC_API_KEY=your_goupc_api_key
KROGER_CLIENT_ID=your_kroger_client_id
KROGER_CLIENT_SECRET=your_kroger_client_secret

# Barcode Enrichment — Open-Source API Providers
UPC_DATABASE_API_KEY=your_upc_database_api_key

# Wholesale Matching — Faire Integration
FAIRE_API_KEY=your_faire_api_key
FAIRE_API_URL=https://api.faire.com/wholesale
FAIRE_WEBHOOK_SECRET=your_faire_webhook_secret

# Logging & Observability
LOG_LEVEL=info                    # debug | info | warn | error
LOG_DIR=./logs                    # File log directory (production only)
LOG_DB_ENABLED=false              # Set to 'true' to force-enable DB error logging in dev
LOG_RETENTION_DAYS=30             # File log retention (days) — used by purge job
SENTRY_DSN=                       # Sentry error tracking DSN (leave empty to disable)
SENTRY_ENVIRONMENT=               # Sentry environment label (defaults to NODE_ENV)
SENTRY_API_TOKEN=                 # Sentry API token for admin monitoring dashboard
SENTRY_ORG_SLUG=                  # Sentry organization slug for admin dashboard
NEW_RELIC_LICENSE_KEY=            # New Relic APM license key (production only)
NEW_RELIC_APP_NAME=VisibleShelf API

# AI Providers & Vercel AI Gateway
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_token
AI_GATEWAY_ENABLED=false
AI_GATEWAY_DEFAULT_CHAT_MODEL=openai/gpt-4o-mini
AI_GATEWAY_DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key
MISTRAL_API_KEY=your_mistral_api_key

# Google Business Profile transport (lib/google/gbp-transport.ts)
# The GBP APIs are not public: a project has 0 QPM until Google allowlists it, and
# Google ships no sandbox. `fixture` serves recorded JSON so the connect → list →
# link → sync flow is testable without the appeal. Never enable in production.
#   GBP_TRANSPORT=live      real Google calls (default)
#   GBP_TRANSPORT=fixture   serve from GBP_FIXTURE_DIR, never touch Google
#   GBP_TRANSPORT=record    call Google and write responses into GBP_FIXTURE_DIR
GBP_TRANSPORT=live
# Defaults to ./fixtures/gbp/approved; point at ./fixtures/gbp/pending to
# reproduce the live `api_not_approved` 503.
GBP_FIXTURE_DIR=
# Escape hatch for a staging process that runs with NODE_ENV=production.
GBP_FIXTURE_ALLOW_PROD=false

